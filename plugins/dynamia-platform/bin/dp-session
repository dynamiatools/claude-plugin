#!/bin/sh
# SessionStart hook: print the dp-detect summary, only inside a Dynamia project. Silent otherwise, never fails.
here=$(cd "$(dirname "$0")" && pwd)
payload=$(cat 2>/dev/null)
cwd=$(printf '%s' "$payload" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
"$here/dp-detect" "${cwd:-${CLAUDE_PROJECT_DIR:-.}}" 2>/dev/null
exit 0
