#!/usr/bin/env bash
# ms-workspace: mechanical helper for the multi-repo batch workflow.
# Reads <workspace>/workspace.toml (created by the ms-workspace-init skill).
# Deterministic on purpose: skills and hooks call it so the model does not
# have to spend tokens on git/test plumbing.
#
# Usage:
#   ms-workspace batch new <name> [repo...]    create a batch (one worktree per repo, branch int/<name>)
#   ms-workspace affected                      JSON: changed repos/modules and their dependents
#   ms-workspace agent new <batch> <task> [repo...]   isolated worktree per agent (branch agent/<batch>/<task>)
#   ms-workspace test t0                       test what changed in the current repo
#   ms-workspace test t1 [batch]               affected + critical modules for every changed repo of the batch
#   ms-workspace test t2 [batch]               end-to-end command from [e2e] in workspace.toml
#   ms-workspace integrate <batch> [--dry-run] merge agent branches into int/<batch> (conflicts detected first)
#   ms-workspace ship <batch> [--yes] [--skip-e2e]   sync with base, test, push (plan only without --yes)
#   ms-workspace clean [<batch>] [--force]     list batches, or remove one that is already merged
#   ms-workspace log [-n N] [--day YYYY-MM-DD] [--action A]   show recent actions
#   ms-workspace context                       ~15-line briefing (for a SessionStart hook)
#   ms-workspace status [--fetch]              one line per repo: branch, ahead/behind base, dirty, batches
#   ms-workspace claude-md [--print]           (re)generate <workspace>/CLAUDE.md; only the managed block is touched
#   ms-workspace usage [--check] [--need PCT] [--json|--line]   plan usage: 5h session and 7d week, pace, verdict
#   ms-workspace doctor                        check tools, versions, resources and workspace.toml
#   ms-workspace guard                         PreToolUse hook: blocks git push / gh pr create|merge in batch worktrees
#
# Workspace discovery: $MS_WORKSPACE, else the nearest parent holding workspace.toml.
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is required"
command -v python3 >/dev/null || die "python3 (>= 3.11, for tomllib) is required"

find_ws() {
  local d="${MS_WORKSPACE:-$PWD}"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/workspace.toml" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
# Load the workspace config into globals. Returns 1 when none is found.
load_ws() {
  WS_ROOT="$(find_ws)" || return 1
  CFG="$WS_ROOT/workspace.toml"
  CFG_JSON="$(python3 -c 'import sys,json,tomllib; print(json.dumps(tomllib.load(open(sys.argv[1],"rb"))))' "$CFG")" \
    || die "could not parse $CFG (needs Python >= 3.11)"
  STATE_DIR="$WS_ROOT/.ms-workspace"
  LOG_DIR="$STATE_DIR/logs"
  BATCH_DIR="$WS_ROOT/.batches"
}
need_ws() { load_ws || die "no workspace.toml found (run the ms-workspace-init skill first)"; }

cfg() { jq -r "$@" <<<"$CFG_JSON"; }

# ---------- logging: one JSON line per action, one file per day ----------
log_event() { # action status repo batch detail
  local file today
  today="$(date +%F)"; file="$LOG_DIR/$today.jsonl"
  mkdir -p "$LOG_DIR"
  if [[ ! -f "$file" ]]; then # first write of the day: rotate old files
    find "$LOG_DIR" -name '*.jsonl' -mtime +"$(cfg '.log_retention_days // 14')" -delete 2>/dev/null || true
  fi
  jq -cn --arg ts "$(date -Is)" --arg action "$1" --arg status "$2" \
        --arg repo "${3:-}" --arg batch "${4:-}" --arg detail "${5:-}" \
        '{ts:$ts,action:$action,status:$status,repo:$repo,batch:$batch,detail:$detail}' >> "$file"
}

cmd_log() {
  need_ws
  local n=20 day="" action=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) n="$2"; shift 2 ;;
      --day) day="$2"; shift 2 ;;
      --action) action="$2"; shift 2 ;;
      *) die "log: unknown option $1" ;;
    esac
  done
  [[ -d "$LOG_DIR" ]] || { echo "(no log yet)"; return 0; }
  local files
  if [[ -n "$day" ]]; then files="$LOG_DIR/$day.jsonl"; [[ -f "$files" ]] || { echo "(no log for $day)"; return 0; }
  else files="$(ls -1 "$LOG_DIR"/*.jsonl 2>/dev/null | sort)"; fi
  [[ -n "$files" ]] || { echo "(no log yet)"; return 0; }
  # shellcheck disable=SC2086
  cat $files | jq -c --arg a "$action" 'select($a=="" or .action==$a)' | tail -n "$n" \
    | jq -r '[.ts[0:19], .status, .action, .repo, .batch, .detail] | map(select(.!="")) | join(" | ")'
}

# ---------- helpers ----------
repo_names() { cfg '.repos | keys[]'; }
repo_base()  { cfg --arg r "$1" '.repos[$r].base // "main"'; }

# Echo the repo name of the git toplevel containing the cwd.
current_repo() {
  local top; top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo"
  basename "$top"
}

# Nearest-pom modules for the files changed in the current repo vs its base.
changed_files() { # base
  local mb
  mb="$(git merge-base HEAD "origin/$1" 2>/dev/null || git merge-base HEAD "$1" 2>/dev/null || echo HEAD)"
  { git diff --name-only "$mb"; git ls-files -o --exclude-standard; } | sort -u
}
modules_of() { # reads file list on stdin, run from repo top
  [[ -f pom.xml ]] || { cat >/dev/null; return 0; }
  local f d
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    d="$(dirname "$f")"
    while [[ "$d" != "." && ! -f "$d/pom.xml" ]]; do d="$(dirname "$d")"; done
    echo "$d"
  done | sort -u
}

# ---------- batch new ----------
cmd_batch() {
  need_ws
  [[ "${1:-}" == "new" ]] || die "usage: batch new <name> [repo...]"; shift
  local name="${1:?batch new <name> [repo...]}"; shift
  local repos=("$@"); [[ ${#repos[@]} -gt 0 ]] || mapfile -t repos < <(repo_names)
  local dir="$BATCH_DIR/$name"
  [[ ! -e "$dir" ]] || die "batch '$name' already exists at $dir"
  mkdir -p "$dir"
  local r base src start
  for r in "${repos[@]}"; do
    src="$WS_ROOT/$r"; base="$(repo_base "$r")"
    if [[ ! -d "$src/.git" ]]; then log_event batch.new error "$r" "$name" "repo not found at $src"; die "repo '$r' not found at $src"; fi
    git -C "$src" fetch origin "$base" --quiet 2>/dev/null || echo "warn: could not fetch $r/$base (using local ref)" >&2
    start="origin/$base"; git -C "$src" rev-parse --verify --quiet "$start" >/dev/null || start="$base"
    git -C "$src" worktree add --no-track -b "int/$name" "$dir/$r" "$start" >/dev/null 2>&1 \
      || { log_event batch.new error "$r" "$name" "worktree add failed"; die "could not create worktree for $r (branch int/$name may exist)"; }
    log_event batch.new ok "$r" "$name" "int/$name from $start"
    echo "  $r -> $dir/$r (int/$name from $start)"
  done
  printf '# Batch: %s\n\nRepos: %s\n\n## Tasks\n- [ ] \n' "$name" "${repos[*]}" > "$dir/TASKS.md"
  echo "Batch ready: $dir"
}

# ---------- affected ----------
cmd_affected() {
  need_ws
  local top repo base files mods
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run inside a repo or batch worktree"
  repo="$(basename "$top")"; base="$(repo_base "$repo")"
  cd "$top"
  files="$(changed_files "$base")"
  mods="$(printf '%s\n' "$files" | modules_of | jq -R . | jq -sc 'map(select(length>0))')"
  # Downstream repos: anything depending (transitively) on this repo.
  jq -c --arg r "$repo" --argjson mods "$mods" --argjson n "$(printf '%s\n' "$files" | grep -c . || true)" '
    . as $c
    | def down($s): ($c.repos | to_entries | map(select(.value.deps as $d | any($s[]; . as $x | $d | index($x)))) | map(.key)) as $new
        | if ($new - $s | length) == 0 then $s else down(($s + $new) | unique) end;
    {repo:$r, files:$n, modules:$mods, dependents:(down([$r]) - [$r])}' <<<"$CFG_JSON"
}

# ---------- shared batch helpers ----------
batch_of_cwd() {
  case "$PWD/" in "$BATCH_DIR"/*) local rest="${PWD#"$BATCH_DIR"/}"; echo "${rest%%/*}" ;; esac
}
batch_repos() { find "$BATCH_DIR/$1" -mindepth 1 -maxdepth 1 -type d ! -name '.agents' -printf '%f\n' | sort; }
base_ref() { # dir base -> origin/<base> when it exists, else <base>
  if git -C "$1" rev-parse --verify --quiet "origin/$2" >/dev/null; then echo "origin/$2"; else echo "$2"; fi
}
ahead_of_base() { git -C "$1" rev-list --count "$(base_ref "$1" "$2")..HEAD"; }
# Repo names on stdin -> printed in dependency order (dependencies first).
topo() {
  local remaining=() next=() r d ready progress
  mapfile -t remaining
  while [[ ${#remaining[@]} -gt 0 ]]; do
    progress=0; next=()
    for r in "${remaining[@]}"; do
      ready=1
      for d in $(cfg --arg r "$r" '.repos[$r].deps[]?'); do
        if printf '%s\n' "${remaining[@]}" | grep -qx "$d"; then ready=0; break; fi
      done
      if [[ $ready -eq 1 ]]; then echo "$r"; progress=1; else next+=("$r"); fi
    done
    [[ $progress -eq 1 ]] || { printf '%s\n' "${next[@]}"; return 0; } # dependency cycle: emit the rest
    remaining=("${next[@]+"${next[@]}"}")
  done
}
need_batch() { # name -> validates, echoes it
  [[ -n "${1:-}" && -d "$BATCH_DIR/$1" ]] || die "unknown batch '${1:-}' (see: ms-workspace clean)"
  echo "$1"
}

# ---------- test ----------
# run_tests <repo> <dir> <level>: runs the affected (or full) tests in <dir>; returns the test exit code.
run_tests() {
  local repo="$1" dir="$2" level="$3" batch="${4:-$(batch_of_cwd)}" base mods crit cmd out rc=0 start
  base="$(repo_base "$repo")"
  mods="$(cd "$dir" && changed_files "$base" | modules_of | paste -sd, -)"
  if [[ "$level" != "t0" ]]; then
    crit="$(cfg --arg r "$repo" '.repos[$r].critical // [] | join(",")')"
    [[ -n "$crit" ]] && mods="$(printf '%s,%s' "$mods" "$crit" | tr ',' '\n' | grep . | sort -u | paste -sd, -)"
  fi
  cmd=""
  if [[ -n "$mods" ]]; then cmd="$(cfg --arg r "$repo" '.repos[$r].test.affected // empty')"; cmd="${cmd//\{modules\}/$mods}"; fi
  [[ -n "$cmd" ]] || cmd="$(cfg --arg r "$repo" '.repos[$r].test.unit // empty')"
  [[ -n "$cmd" ]] || die "no test command configured for '$repo' in workspace.toml"
  mkdir -p "$STATE_DIR"; out="$(mktemp)"; start=$SECONDS
  # One heavy run at a time per workspace, so parallel agents don't starve the machine.
  (cd "$dir" && flock -w 1800 "$STATE_DIR/heavy.lock" bash -c "$cmd") >"$out" 2>&1 || rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "PASS $level $repo ($((SECONDS-start))s): $cmd"
    log_event "test.$level" ok "$repo" "$batch" "$cmd"
  else
    echo "FAIL $level $repo ($((SECONDS-start))s): $cmd" >&2; tail -n 40 "$out" >&2
    log_event "test.$level" fail "$repo" "$batch" "$cmd"
  fi
  rm -f "$out"; return $rc
}

run_e2e() { # batch -> runs [e2e].command
  local cmd erepo dir rc=0 out start=$SECONDS
  cmd="$(cfg '.e2e.command // empty')"; [[ -n "$cmd" ]] || { echo "no [e2e] command configured" >&2; return 2; }
  erepo="$(cfg '.e2e.repo // empty')"
  dir="$WS_ROOT/${erepo:-.}"; [[ -n "$1" && -d "$BATCH_DIR/$1/$erepo" ]] && dir="$BATCH_DIR/$1/$erepo"
  mkdir -p "$STATE_DIR"; out="$(mktemp)"
  (cd "$dir" && flock -w 3600 "$STATE_DIR/heavy.lock" bash -c "$cmd") >"$out" 2>&1 || rc=$?
  if [[ $rc -eq 0 ]]; then echo "PASS t2 e2e ($((SECONDS-start))s): $cmd"; log_event test.t2 ok "$erepo" "$1" "$cmd"
  else echo "FAIL t2 e2e ($((SECONDS-start))s): $cmd" >&2; tail -n 40 "$out" >&2; log_event test.t2 fail "$erepo" "$1" "$cmd"; fi
  rm -f "$out"; return $rc
}

cmd_test() {
  need_ws
  local level="${1:-}" batch r wt rc=0
  case "$level" in
    t0)
      local top; top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run inside a repo or batch worktree"
      run_tests "$(basename "$top")" "$top" t0 ;;
    t1)
      batch="$(need_batch "${2:-$(batch_of_cwd)}")"
      while read -r r; do
        wt="$BATCH_DIR/$batch/$r"
        [[ "$(ahead_of_base "$wt" "$(repo_base "$r")")" -gt 0 ]] || { echo "skip $r (no changes vs base)"; continue; }
        run_tests "$r" "$wt" t1 "$batch" || { rc=$?; break; }
      done < <(batch_repos "$batch" | topo)
      return $rc ;;
    t2)
      batch="$(need_batch "${2:-$(batch_of_cwd)}")"; run_e2e "$batch" ;;
    *) die "usage: test t0|t1|t2 [batch]" ;;
  esac
}

# ---------- agent new ----------
cmd_agent() {
  need_ws
  [[ "${1:-}" == "new" ]] || die "usage: agent new <batch> <task> [repo...]"; shift
  local batch task r wt
  batch="$(need_batch "${1:-}")"; task="${2:?agent new <batch> <task> [repo...]}"; shift 2
  local repos=("$@"); [[ ${#repos[@]} -gt 0 ]] || mapfile -t repos < <(batch_repos "$batch")
  for r in "${repos[@]}"; do
    wt="$BATCH_DIR/$batch/.agents/$task/$r"
    [[ -d "$BATCH_DIR/$batch/$r" ]] || die "repo '$r' is not part of batch '$batch'"
    git -C "$BATCH_DIR/$batch/$r" worktree add --no-track -b "agent/$batch/$task" "$wt" "int/$batch" >/dev/null 2>&1 \
      || die "could not create agent worktree for $r (branch agent/$batch/$task may exist)"
    log_event agent.new ok "$r" "$batch" "agent/$batch/$task"
    echo "  $r -> $wt (agent/$batch/$task)"
  done
}

# ---------- integrate ----------
cmd_integrate() {
  need_ws
  local batch dry=0 r wt br out files conflict=0
  batch="$(need_batch "${1:-}")"; shift || true
  [[ "${1:-}" == "--dry-run" ]] && dry=1
  while read -r r; do
    wt="$BATCH_DIR/$batch/$r"
    [[ $dry -eq 1 || -z "$(git -C "$wt" status --porcelain)" ]] || die "$r: int/$batch worktree has uncommitted changes"
    for br in $(git -C "$wt" for-each-ref --format='%(refname:short)' "refs/heads/agent/$batch/"); do
      if git -C "$wt" merge-base --is-ancestor "$br" HEAD; then echo "  $r: $br already merged"; continue; fi
      if out="$(git -C "$wt" merge-tree --write-tree --name-only HEAD "$br" 2>&1)"; then
        if [[ $dry -eq 1 ]]; then echo "  $r: $br merges cleanly"
        else
          git -C "$wt" merge --no-ff --no-edit -m "Integrate $br" "$br" >/dev/null
          log_event integrate ok "$r" "$batch" "$br"; echo "  $r: merged $br"
        fi
      else
        files="$(printf '%s\n' "$out" | sed -n '2,/^$/p' | sed '/^$/d' | paste -sd' ' -)"
        echo "  $r: CONFLICT merging $br -> $files" >&2
        log_event integrate conflict "$r" "$batch" "$br: $files"; conflict=1
      fi
    done
  done < <(batch_repos "$batch" | topo)
  if [[ $conflict -eq 1 ]]; then echo "Resolve the conflicts (rebase the agent branch on int/$batch), then run again." >&2; return 1; fi
  [[ $dry -eq 1 ]] || echo "Integrated. Next: ms-workspace test t1 $batch"
}

# ---------- ship ----------
cmd_ship() {
  need_ws
  local batch yes=0 skip_e2e=0 r wt base ahead mode arg
  batch="$(need_batch "${1:-}")"; shift || true
  for arg in "$@"; do case "$arg" in --yes) yes=1 ;; --skip-e2e) skip_e2e=1 ;; *) die "ship: unknown option $arg" ;; esac; done
  local repos=()
  while read -r r; do
    wt="$BATCH_DIR/$batch/$r"; base="$(repo_base "$r")"
    [[ -z "$(git -C "$wt" status --porcelain)" ]] || die "$r: uncommitted changes in int/$batch"
    [[ "$(cfg --arg r "$r" --arg b "$base" '(.repos[$r].release // []) | index($b) != null')" == "false" ]] \
      || die "$r: base '$base' is a release branch; ship never targets those"
    git -C "$WS_ROOT/$r" fetch origin "$base" --quiet 2>/dev/null || echo "warn: could not fetch $r/$base" >&2
    ahead="$(ahead_of_base "$wt" "$base")"
    [[ "$ahead" -gt 0 ]] || { echo "skip $r (nothing to ship)"; continue; }
    repos+=("$r")
  done < <(batch_repos "$batch" | topo)
  [[ ${#repos[@]} -gt 0 ]] || { echo "Nothing to ship in batch '$batch'."; return 0; }

  echo "Plan for batch '$batch':"
  for r in "${repos[@]}"; do
    mode="$(cfg --arg r "$r" '.repos[$r].push // "direct"')"
    echo "  $r: int/$batch -> $(repo_base "$r") ($mode, $(ahead_of_base "$BATCH_DIR/$batch/$r" "$(repo_base "$r")") commits)"
  done
  if [[ $yes -eq 0 ]]; then echo "(plan only; pass --yes to run: sync, t1, e2e, push)"; return 0; fi

  # 1) sync with base (merge, since int/* is local-only)
  for r in "${repos[@]}"; do
    wt="$BATCH_DIR/$batch/$r"; base="$(repo_base "$r")"
    if ! git -C "$wt" merge-base --is-ancestor "origin/$base" HEAD 2>/dev/null; then
      echo "  $r: base moved, merging origin/$base"
      git -C "$wt" merge --no-edit "origin/$base" >/dev/null 2>&1 || {
        git -C "$wt" merge --abort 2>/dev/null || true
        log_event ship conflict "$r" "$batch" "merging origin/$base"
        die "$r: conflict merging origin/$base into int/$batch; resolve it in $wt and run ship again"; }
    fi
  done
  # 2) tests
  cmd_test t1 "$batch" || { log_event ship fail "" "$batch" "t1 failed"; die "t1 failed; nothing was pushed"; }
  if [[ $skip_e2e -eq 0 ]]; then
    [[ -n "$(cfg '.e2e.command // empty')" ]] || die "no [e2e] command configured; pass --skip-e2e to ship without e2e"
    run_e2e "$batch" || { log_event ship fail "" "$batch" "t2 failed"; die "e2e failed; nothing was pushed"; }
  fi
  # 3) push
  for r in "${repos[@]}"; do
    wt="$BATCH_DIR/$batch/$r"; base="$(repo_base "$r")"; mode="$(cfg --arg r "$r" '.repos[$r].push // "direct"')"
    if [[ "$mode" == "pr" ]]; then
      git -C "$wt" push origin "int/$batch" && (cd "$wt" && gh pr create --base "$base" --head "int/$batch" --fill) \
        || die "$r: could not open the PR"
    else
      git -C "$wt" push origin "int/$batch:$base" || die "$r: push to $base rejected (base moved again? run ship again)"
    fi
    log_event ship ok "$r" "$batch" "int/$batch -> $base ($mode)"; echo "  pushed $r"
  done
  echo "Shipped. Cleanup: ms-workspace clean $batch"
}

# ---------- clean ----------
cmd_clean() {
  need_ws
  local force=0 batch="" arg r wt b all_merged
  for arg in "$@"; do case "$arg" in --force) force=1 ;; *) batch="$arg" ;; esac; done
  if [[ -z "$batch" ]]; then
    [[ -d "$BATCH_DIR" ]] || { echo "(no batches)"; return 0; }
    for b in "$BATCH_DIR"/*/; do
      [[ -d "$b" ]] || continue
      b="$(basename "$b")"; all_merged=yes
      while read -r r; do
        git -C "$BATCH_DIR/$b/$r" merge-base --is-ancestor HEAD "$(base_ref "$BATCH_DIR/$b/$r" "$(repo_base "$r")")" 2>/dev/null || all_merged=no
      done < <(batch_repos "$b")
      echo "$b: $([[ $all_merged == yes ]] && echo 'merged (safe to clean)' || echo 'pending')"
    done
    return 0
  fi
  batch="$(need_batch "$batch")"
  if [[ $force -eq 0 ]]; then
    while read -r r; do
      wt="$BATCH_DIR/$batch/$r"
      git -C "$wt" merge-base --is-ancestor HEAD "$(base_ref "$wt" "$(repo_base "$r")")" 2>/dev/null \
        || die "$r: int/$batch is not merged into $(repo_base "$r") yet (use --force to discard)"
    done < <(batch_repos "$batch")
  fi
  local f=(); [[ $force -eq 1 ]] && f=(--force)
  while read -r r; do
    for wt in "$BATCH_DIR/$batch"/.agents/*/"$r"; do
      [[ -d "$wt" ]] && git -C "$BATCH_DIR/$batch/$r" worktree remove "${f[@]}" "$wt"
    done
    git -C "$BATCH_DIR/$batch/$r" worktree remove "${f[@]}" "$BATCH_DIR/$batch/$r"
    for b in $(git -C "$WS_ROOT/$r" for-each-ref --format='%(refname:short)' "refs/heads/agent/$batch/" "refs/heads/int/$batch"); do
      git -C "$WS_ROOT/$r" branch -D "$b" >/dev/null
    done
    log_event clean ok "$r" "$batch" ""
    echo "  cleaned $r"
  done < <(batch_repos "$batch")
  # Only empty directories and the TASKS.md note remain; ${VAR:?} aborts if a variable is empty.
  rm -f "${BATCH_DIR:?}/${batch:?}/TASKS.md"
  find "${BATCH_DIR:?}/${batch:?}" -depth -type d -empty -delete 2>/dev/null || true
}

# ---------- guard (PreToolUse hook) ----------
# Reads the hook JSON on stdin. Exit 2 (with a reason on stderr) blocks the call.
# Only acts inside a batch worktree; humans pushing from normal checkouts are untouched.
cmd_guard() {
  local input cwd command
  input="$(cat)"
  command="$(jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null)" || exit 0
  [[ -n "$command" ]] || exit 0
  cwd="$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)"
  [[ -n "$cwd" && -d "$cwd" ]] && cd "$cwd"
  load_ws || exit 0
  case "$PWD/" in "$BATCH_DIR"/*) ;; *) exit 0 ;; esac
  if grep -Eq '\bgit\b([[:space:]]+(-C|-c)[[:space:]]+[^[:space:]]+|[[:space:]]+--[^[:space:]]+)*[[:space:]]+push\b|\bgh[[:space:]]+pr[[:space:]]+(create|merge)\b|\bms-workspace[[:space:]]+(ship|clean)\b' <<<"$command"; then
    log_event guard blocked "" "" "$command"
    echo "Blocked: agents in a batch worktree must not push, open/merge PRs, or run 'ms-workspace ship|clean'. Commit locally; the human integrates with 'ms-workspace ship'." >&2
    exit 2
  fi
  exit 0
}

# ---------- status ----------
cmd_status() {
  need_ws
  local fetch=0; [[ "${1:-}" == "--fetch" ]] && fetch=1
  local r dir base br ahead behind dirty batches
  while read -r r; do
    dir="$WS_ROOT/$r"
    if [[ ! -d "$dir/.git" ]]; then echo "$r: (not cloned)"; continue; fi
    base="$(repo_base "$r")"
    [[ $fetch -eq 1 ]] && git -C "$dir" fetch origin "$base" --quiet 2>/dev/null || true
    br="$(git -C "$dir" branch --show-current)"
    read -r behind ahead < <(git -C "$dir" rev-list --left-right --count "origin/$base...HEAD" 2>/dev/null || echo "? ?")
    dirty="$(git -C "$dir" status --porcelain | grep -c . || true)"
    batches="$(ls -d "$BATCH_DIR"/*/"$r" 2>/dev/null | awk -F/ '{print $(NF-1)}' | paste -sd, -)"
    echo "$r: $br | vs $base: +$ahead/-$behind | dirty $dirty${batches:+ | batches: $batches}"
  done < <(repo_names)
}

# ---------- context ----------
cmd_context() {
  load_ws || exit 0
  local b name n open
  echo "Workspace '$(cfg '.name // "unnamed"')' at $WS_ROOT ($(repo_names | wc -l) repos). Tool: ms-workspace (log, status, affected, test t0)."
  if [[ -d "$BATCH_DIR" ]] && ls -d "$BATCH_DIR"/*/ >/dev/null 2>&1; then
    echo "Active batches:"
    for b in "$BATCH_DIR"/*/; do
      name="$(basename "$b")"
      open="$(grep -c '^- \[ \]' "$b/TASKS.md" 2>/dev/null || true)"
      echo "  - $name: repos $(ls "$b" | grep -v TASKS.md | paste -sd, -), open tasks: ${open:-0}"
    done
  else
    echo "Active batches: none"
  fi
  cmd_usage --line 2>/dev/null | sed 's/^/Plan /' || true
  echo "Recent actions:"
  cmd_log -n 5 | sed 's/^/  /'
}

# ---------- claude-md ----------
CM_BEGIN='<!-- ms-workspace:begin (generated by `ms-workspace claude-md`; edit outside this block) -->'
CM_END='<!-- ms-workspace:end -->'

render_claude_md() {
  local name tasks
  name="$(cfg '.name // "unnamed"')"; tasks="$(cfg '.tasks // "local"')"
  echo "$CM_BEGIN"
  cat <<EOF
# Workspace: $name

Multi-repo workspace. Each repo keeps its own CLAUDE.md; follow it for code conventions.

## Repos (dependency order)
EOF
  local r
  while read -r r; do
    cfg --arg r "$r" '.repos[$r] | "- \($r): base `\(.base // "main")`, \((.stacks // []) | join("+") | if . == "" then "no stack detected" else . end), push \(.push // "direct")\(if ((.deps // []) | length) > 0 then ", depends on \(.deps | join(", "))" else "" end)"'
  done < <(repo_names | topo)
  cat <<EOF

## Rules for agents
- Work only inside the repo/module assigned to your task, inside a batch worktree (\`.batches/<batch>/...\`).
- Commit locally. Never \`git push\`, open/merge PRs, or run \`ms-workspace ship|clean\`: a hook blocks them and the human integrates.
- After changes run \`ms-workspace test t0\` (tests only what changed). Fix failures before saying you are done.
- Do not create branches or worktrees by hand; use \`ms-workspace batch new\` / \`agent new\`.
- Before starting a task or session run \`ms-workspace usage --check\` (add \`--need <pct>\` with your estimate of the 5h-window share the task needs). Exit 1 or 2: show the numbers and get the user's confirmation first. Exit 3: no data, proceed. Never leave work half done: prefer finishing or cleanly stopping a small step.

## Batch flow (human-driven)
\`batch new\` -> \`agent new\` -> \`test t0\` -> \`integrate\` -> \`test t1\` -> \`ship --yes\` -> \`clean\`.
Skills: /ms-batch, /ms-integrate, /ms-ship.

## Saving tokens
- One agent by default; parallel agents only for independent repos or modules.
- Read \`ms-workspace context\`, \`status\` and \`log\` before exploring the repos.
- Delegate code search to \`ms-agent-scout\`, failing-test analysis to \`ms-agent-test-triage\`, summaries and commit drafts to \`ms-agent-summarizer\` (all Haiku).

## Tool preference
1. IDE tools (\`mcp__idea__*\`) when available.
2. codebase-memory graph tools for structure, callers and impact.
3. Grep/Glob/Read as the fallback; never block on a missing tool.
Shell output is filtered by \`rtk\` when it is installed.

## Tasks
Tracking mode: \`$tasks\` (\`local\` = TASKS.md inside each batch; \`github\` = one tracking issue per batch).
EOF
  echo "$CM_END"
}

cmd_claude_md() {
  need_ws
  local target="$WS_ROOT/CLAUDE.md" blockfile tmp
  if [[ "${1:-}" == "--print" ]]; then render_claude_md; return 0; fi
  blockfile="$(mktemp)"; tmp="$(mktemp)"
  render_claude_md > "$blockfile"
  if [[ -f "$target" ]] && grep -qF "$CM_BEGIN" "$target"; then
    awk -v b="$CM_BEGIN" -v e="$CM_END" -v f="$blockfile" '
      index($0,b){ while((getline l < f)>0) print l; skip=1; next }
      index($0,e){ skip=0; next }
      !skip{ print }' "$target" > "$tmp"
    echo "Updated managed block in $target"
  elif [[ -f "$target" ]]; then
    { cat "$target"; echo; cat "$blockfile"; } > "$tmp"
    echo "Appended managed block to existing $target"
  else
    cat "$blockfile" > "$tmp"
    echo "Created $target"
  fi
  cat "$tmp" > "$target"; rm -f "$blockfile" "$tmp"
  log_event claude-md ok "" "" "$target"
}

# ---------- usage ----------
# Reads the snapshot written by ms-statusline (Claude Code only exposes plan usage to the status line).
USAGE_JQ='
def dur($s): ($s|floor) as $s | if $s<=0 then "0m" elif $s<3600 then "\($s/60|floor)m"
  elif $s<86400 then "\($s/3600|floor)h\(($s%3600)/60|floor)m" else "\($s/86400|floor)d\(($s%86400)/3600|floor)h" end;
def analyze($w; $len):
  if $w == null or $w.used_percentage == null then {state:"nodata"}
  else ($w.resets_at - $now) as $left
  | if $left <= 0 then {state:"reset"}
    else ($len - $left) as $el | ($el/$len) as $ef | $w.used_percentage as $u
    | {state:"active", used:$u, left:(100-$u), resets_in:$left,
       pace: (if $ef >= 0.05 then ($u/($ef*100)) else null end),
       projected: (if $ef >= 0.05 then ($u/$ef) else null end),
       eta100: (if $ef >= 0.05 and $u > 0 then ((100-$u)/($u/$el)) else null end)}
    end end;
def level($a; $session):
  if $a.state != "active" then 0
  else (($a.used >= $stop)
        or ($session and $need > 0 and ($a.used + $need) > 100)
        or ($a.used >= 70 and $a.eta100 != null and $a.eta100 < 1800 and $a.eta100 < $a.resets_in)) as $crit
     | (($a.used >= $warn)
        or ($a.used >= 50 and $a.projected != null and $a.projected > 100)
        or ($session and $need > 0 and ($a.used + $need) > $stop)) as $warnb
     | if $crit then 2 elif $warnb then 1 else 0 end
  end;
def line($name; $a):
  if $a.state == "nodata" then "\($name): no data"
  elif $a.state == "reset" then "\($name): window reset since the last data (usage unknown, probably low)"
  else "\($name): \($a.used|round)% used, \($a.left|round)% left | resets in \(dur($a.resets_in))"
    + (if $a.pace != null then " | pace x\(($a.pace*10|round)/10) | ~\($a.projected|round)% at reset" else " | too early to project" end)
    + (if ($a.eta100 != null and $a.eta100 < $a.resets_in) then " | hits 100% in ~\(dur($a.eta100))" else "" end)
  end;
analyze(.five_hour; 18000) as $s | analyze(.seven_day; 604800) as $w
| ([level($s; true), level($w; false)] | max) as $lv
| {age_s: ($now - .captured_at), session: $s, week: $w, level: $lv, verdict: (["ok","warn","critical"][$lv]),
   nodata: ($s.state == "nodata" and $w.state == "nodata"),
   text: ([line("5h session"; $s), line("7d week   "; $w)] | join("\n")),
   short: ("usage 5h " + (if $s.state=="active" then "\($s.used|round)% (resets in \(dur($s.resets_in)))" else "n/a" end)
           + ", 7d " + (if $w.state=="active" then "\($w.used|round)%" else "n/a" end)
           + " - " + (["ok","WARN","CRITICAL"][$lv]))}'

cmd_usage() {
  load_ws 2>/dev/null || true
  local check=0 need=0 mode=text arg warn=70 stop=90 stale=15
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check=1; shift ;;
      --need)  need="${2:?--need needs a percentage}"; shift 2 ;;
      --json)  mode=json; shift ;;
      --line)  mode=line; shift ;;
      *) die "usage: unknown option $1" ;;
    esac
  done
  [[ -n "${CFG_JSON:-}" ]] && {
    warn="$(cfg '.usage.warn_pct // 70')"; stop="$(cfg '.usage.stop_pct // 90')"; stale="$(cfg '.usage.stale_minutes // 15')"; }
  local snap="${MS_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ms-workspace}/usage.json" res
  if [[ ! -f "$snap" ]]; then
    [[ $mode == line ]] || echo "No usage data yet. Enable ms-statusline (see README) on a Pro/Max plan; data appears after the first reply of a session." >&2
    [[ $check -eq 1 ]] && return 3 || return 0
  fi
  res="$(jq --argjson now "$(date +%s)" --argjson warn "$warn" --argjson stop "$stop" --argjson need "$need" "$USAGE_JQ" "$snap")" \
    || die "could not read $snap"
  if [[ "$(jq -r .nodata <<<"$res")" == "true" ]]; then
    [[ $mode == line ]] || echo "Usage snapshot has no rate-limit data (API-key plans do not report it)." >&2
    [[ $check -eq 1 ]] && return 3 || return 0
  fi
  case "$mode" in
    json) echo "$res" ;;
    line) jq -r .short <<<"$res" ;;
    *)
      jq -r --argjson need "$need" --argjson stale "$stale" '
        .text
        + (if $need > 0 then "\nplanned task: ~\($need)% of the 5h window" else "" end)
        + "\nverdict: \(.verdict | ascii_upcase) - "
        + (if .level == 2 then "stop and confirm with the user before starting; do not leave work half done"
           elif .level == 1 then "confirm with the user; prefer small steps that can be finished"
           else "proceed" end)
        + (if .age_s > ($stale * 60) then "\n(data is \(.age_s/60|floor) min old; it refreshes while a Claude session is running)" else "" end)' <<<"$res" ;;
  esac
  if [[ $check -eq 1 ]]; then return "$(jq -r .level <<<"$res")"; fi
  return 0
}

# ---------- doctor ----------
cmd_doctor() {
  load_ws || echo "(no workspace.toml here: checking general tools only)"
  local bad=0
  ok()   { printf '  ok       %s\n' "$*"; }
  miss() { printf '  MISSING  %s\n' "$*"; bad=1; }
  warn() { printf '  warn     %s\n' "$*"; }
  have() { command -v "$1" >/dev/null 2>&1; }
  want() { if have "$1"; then ok "$1"; else miss "$1${2:+ ($2)}"; fi; }

  echo "Tools:"
  for t in git jq python3 gh; do want "$t"; done
  python3 -c 'import sys; sys.exit(0 if sys.version_info>=(3,11) else 1)' 2>/dev/null \
    && ok "python >= 3.11" || miss "python >= 3.11 (tomllib)"
  have claude && ok claude || warn "claude not in PATH"
  have tmux && ok tmux || warn "tmux (needed by ms-tmux-session)"
  have rtk && ok rtk || warn "rtk (optional: token-optimized shell output)"

  if [[ -n "${CFG_JSON:-}" ]]; then
    local stacks; stacks="$(cfg '[.repos[].stacks[]?] | unique | join(" ")')"
    echo "Stack tools (from workspace.toml: ${stacks:-none}):"
    [[ " $stacks " == *" maven "* ]]  && { want mvn; want java; have java && ok "$(java -version 2>&1 | head -1)"; }
    [[ " $stacks " == *" gradle "* ]] && want java
    [[ " $stacks " == *" pnpm "* ]]   && { want node; want pnpm; }
    [[ " $stacks " == *" npm "* ]]    && want node
    [[ " $stacks " == *" go "* ]]     && want go
    [[ " $stacks " == *" rust "* ]]   && want cargo
    [[ -n "$(cfg '.e2e.command // empty')" || -n "$(find "$WS_ROOT" -maxdepth 2 -name 'docker-compose*.yml' 2>/dev/null | head -1)" ]] && want docker

    echo "Workspace:"
    local r base d
    while read -r r; do
      if [[ ! -d "$WS_ROOT/$r/.git" ]]; then miss "repo '$r' not cloned at $WS_ROOT/$r"; continue; fi
      base="$(repo_base "$r")"
      git -C "$WS_ROOT/$r" rev-parse --verify --quiet "origin/$base" >/dev/null \
        || git -C "$WS_ROOT/$r" rev-parse --verify --quiet "$base" >/dev/null \
        || miss "repo '$r': base branch '$base' not found"
      for d in $(cfg --arg r "$r" '.repos[$r].deps[]?'); do
        cfg --arg d "$d" '.repos | has($d)' | grep -q true || miss "repo '$r' depends on unknown repo '$d'"
      done
    done < <(repo_names)
    [[ $bad -eq 0 ]] && ok "all repos present, bases and deps valid"
  fi

  echo "Plan usage:"
  local snap="${MS_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ms-workspace}/usage.json" age
  if [[ -f "$snap" ]]; then
    age=$(( ( $(date +%s) - $(jq -r .captured_at "$snap") ) / 60 ))
    ok "usage snapshot ${age} min old (ms-statusline is working)"
  else
    warn "no usage snapshot: add ms-statusline as statusLine in settings.json (Pro/Max plans only)"
  fi

  echo "Resources:"
  local ram disk
  ram="$(free -g 2>/dev/null | awk '/^Mem:/{print $7}')"; disk="$(df -BG --output=avail "${WS_ROOT:-$HOME}" 2>/dev/null | tail -1 | tr -d ' G')"
  [[ -n "$ram" ]] && { [[ "$ram" -ge 4 ]] && ok "${ram}G RAM available" || warn "only ${ram}G RAM available"; }
  [[ -n "$disk" ]] && { [[ "$disk" -ge 10 ]] && ok "${disk}G disk free" || warn "only ${disk}G disk free"; }
  [[ -n "${STATE_DIR:-}" ]] && log_event doctor "$([[ $bad -eq 0 ]] && echo ok || echo fail)" "" "" ""
  return $bad
}

case "${1:-}" in
  guard)     shift; cmd_guard ;;
  status)    shift; cmd_status "$@" ;;
  context)   shift; cmd_context ;;
  claude-md) shift; cmd_claude_md "$@" ;;
  usage)     shift; cmd_usage "$@" ;;
  doctor)    shift; cmd_doctor ;;
  batch)     shift; cmd_batch "$@" ;;
  affected)  shift; cmd_affected "$@" ;;
  test)      shift; cmd_test "$@" ;;
  log)       shift; cmd_log "$@" ;;
  agent)     shift; cmd_agent "$@" ;;
  integrate) shift; cmd_integrate "$@" ;;
  ship)      shift; cmd_ship "$@" ;;
  clean)     shift; cmd_clean "$@" ;;
  ""|-h|--help) sed -n '2,/^set -/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1" ;;
esac
