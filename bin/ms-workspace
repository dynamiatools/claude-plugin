#!/usr/bin/env bash
# ms-workspace: mechanical helper for the multi-repo batch workflow.
# Reads <workspace>/workspace.toml (created by the ms-workspace-init skill).
# Deterministic on purpose: skills and hooks call it so the model does not
# have to spend tokens on git/test plumbing.
#
# Usage:
#   ms-workspace batch new <name> [repo...]    create a batch (one worktree per repo, branch int/<name>)
#   ms-workspace affected                      JSON: changed repos/modules and their dependents
#   ms-workspace test t0                       test what changed in the current repo
#   ms-workspace log [-n N] [--day YYYY-MM-DD] [--action A]   show recent actions
#   ms-workspace context                       ~15-line briefing (for a SessionStart hook)
#   ms-workspace status [--fetch]              one line per repo: branch, ahead/behind base, dirty, batches
#   ms-workspace doctor                        check tools, versions, resources and workspace.toml
#   ms-workspace guard                         PreToolUse hook: blocks git push / gh pr create|merge in batch worktrees
#
# Workspace discovery: $MS_WORKSPACE, else the nearest parent holding workspace.toml.
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is required"
command -v python3 >/dev/null || die "python3 (>= 3.11, for tomllib) is required"

find_ws() {
  local d="${MS_WORKSPACE:-$PWD}"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/workspace.toml" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
# Load the workspace config into globals. Returns 1 when none is found.
load_ws() {
  WS_ROOT="$(find_ws)" || return 1
  CFG="$WS_ROOT/workspace.toml"
  CFG_JSON="$(python3 -c 'import sys,json,tomllib; print(json.dumps(tomllib.load(open(sys.argv[1],"rb"))))' "$CFG")" \
    || die "could not parse $CFG (needs Python >= 3.11)"
  STATE_DIR="$WS_ROOT/.ms-workspace"
  LOG_DIR="$STATE_DIR/logs"
  BATCH_DIR="$WS_ROOT/.batches"
}
need_ws() { load_ws || die "no workspace.toml found (run the ms-workspace-init skill first)"; }

cfg() { jq -r "$@" <<<"$CFG_JSON"; }

# ---------- logging: one JSON line per action, one file per day ----------
log_event() { # action status repo batch detail
  local file today
  today="$(date +%F)"; file="$LOG_DIR/$today.jsonl"
  mkdir -p "$LOG_DIR"
  if [[ ! -f "$file" ]]; then # first write of the day: rotate old files
    find "$LOG_DIR" -name '*.jsonl' -mtime +"$(cfg '.log_retention_days // 14')" -delete 2>/dev/null || true
  fi
  jq -cn --arg ts "$(date -Is)" --arg action "$1" --arg status "$2" \
        --arg repo "${3:-}" --arg batch "${4:-}" --arg detail "${5:-}" \
        '{ts:$ts,action:$action,status:$status,repo:$repo,batch:$batch,detail:$detail}' >> "$file"
}

cmd_log() {
  need_ws
  local n=20 day="" action=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) n="$2"; shift 2 ;;
      --day) day="$2"; shift 2 ;;
      --action) action="$2"; shift 2 ;;
      *) die "log: unknown option $1" ;;
    esac
  done
  [[ -d "$LOG_DIR" ]] || { echo "(no log yet)"; return 0; }
  local files
  if [[ -n "$day" ]]; then files="$LOG_DIR/$day.jsonl"; [[ -f "$files" ]] || { echo "(no log for $day)"; return 0; }
  else files="$(ls -1 "$LOG_DIR"/*.jsonl 2>/dev/null | sort)"; fi
  [[ -n "$files" ]] || { echo "(no log yet)"; return 0; }
  # shellcheck disable=SC2086
  cat $files | jq -c --arg a "$action" 'select($a=="" or .action==$a)' | tail -n "$n" \
    | jq -r '[.ts[0:19], .status, .action, .repo, .batch, .detail] | map(select(.!="")) | join(" | ")'
}

# ---------- helpers ----------
repo_names() { cfg '.repos | keys[]'; }
repo_base()  { cfg --arg r "$1" '.repos[$r].base // "main"'; }

# Echo the repo name of the git toplevel containing the cwd.
current_repo() {
  local top; top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo"
  basename "$top"
}

# Nearest-pom modules for the files changed in the current repo vs its base.
changed_files() { # base
  local mb
  mb="$(git merge-base HEAD "origin/$1" 2>/dev/null || git merge-base HEAD "$1" 2>/dev/null || echo HEAD)"
  { git diff --name-only "$mb"; git ls-files -o --exclude-standard; } | sort -u
}
modules_of() { # reads file list on stdin, run from repo top
  [[ -f pom.xml ]] || { cat >/dev/null; return 0; }
  local f d
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    d="$(dirname "$f")"
    while [[ "$d" != "." && ! -f "$d/pom.xml" ]]; do d="$(dirname "$d")"; done
    echo "$d"
  done | sort -u
}

# ---------- batch new ----------
cmd_batch() {
  need_ws
  [[ "${1:-}" == "new" ]] || die "usage: batch new <name> [repo...]"; shift
  local name="${1:?batch new <name> [repo...]}"; shift
  local repos=("$@"); [[ ${#repos[@]} -gt 0 ]] || mapfile -t repos < <(repo_names)
  local dir="$BATCH_DIR/$name"
  [[ ! -e "$dir" ]] || die "batch '$name' already exists at $dir"
  mkdir -p "$dir"
  local r base src start
  for r in "${repos[@]}"; do
    src="$WS_ROOT/$r"; base="$(repo_base "$r")"
    if [[ ! -d "$src/.git" ]]; then log_event batch.new error "$r" "$name" "repo not found at $src"; die "repo '$r' not found at $src"; fi
    git -C "$src" fetch origin "$base" --quiet 2>/dev/null || echo "warn: could not fetch $r/$base (using local ref)" >&2
    start="origin/$base"; git -C "$src" rev-parse --verify --quiet "$start" >/dev/null || start="$base"
    git -C "$src" worktree add --no-track -b "int/$name" "$dir/$r" "$start" >/dev/null 2>&1 \
      || { log_event batch.new error "$r" "$name" "worktree add failed"; die "could not create worktree for $r (branch int/$name may exist)"; }
    log_event batch.new ok "$r" "$name" "int/$name from $start"
    echo "  $r -> $dir/$r (int/$name from $start)"
  done
  printf '# Batch: %s\n\nRepos: %s\n\n## Tasks\n- [ ] \n' "$name" "${repos[*]}" > "$dir/TASKS.md"
  echo "Batch ready: $dir"
}

# ---------- affected ----------
cmd_affected() {
  need_ws
  local top repo base files mods
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run inside a repo or batch worktree"
  repo="$(basename "$top")"; base="$(repo_base "$repo")"
  cd "$top"
  files="$(changed_files "$base")"
  mods="$(printf '%s\n' "$files" | modules_of | jq -R . | jq -sc 'map(select(length>0))')"
  # Downstream repos: anything depending (transitively) on this repo.
  jq -c --arg r "$repo" --argjson mods "$mods" --argjson n "$(printf '%s\n' "$files" | grep -c . || true)" '
    . as $c
    | def down($s): ($c.repos | to_entries | map(select(.value.deps as $d | any($s[]; . as $x | $d | index($x)))) | map(.key)) as $new
        | if ($new - $s | length) == 0 then $s else down(($s + $new) | unique) end;
    {repo:$r, files:$n, modules:$mods, dependents:(down([$r]) - [$r])}' <<<"$CFG_JSON"
}

# ---------- test ----------
cmd_test() {
  need_ws
  local level="${1:-}"
  [[ "$level" == "t0" ]] || die "only 't0' is implemented so far"
  local top repo base mods cmd start rc out
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run inside a repo or batch worktree"
  repo="$(basename "$top")"; base="$(repo_base "$repo")"
  cd "$top"
  mods="$(changed_files "$base" | modules_of | paste -sd, -)"
  if [[ -n "$mods" ]]; then cmd="$(cfg --arg r "$repo" '.repos[$r].test.affected // empty')"; cmd="${cmd//\{modules\}/$mods}"; fi
  [[ -n "${cmd:-}" ]] || cmd="$(cfg --arg r "$repo" '.repos[$r].test.unit // empty')"
  [[ -n "$cmd" ]] || die "no test command configured for '$repo' in workspace.toml"
  mkdir -p "$STATE_DIR"; out="$(mktemp)"; start=$SECONDS; rc=0
  # One heavy run at a time per workspace, so parallel agents don't starve the machine.
  flock -w 1800 "$STATE_DIR/heavy.lock" bash -c "$cmd" >"$out" 2>&1 || rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "PASS t0 $repo ($((SECONDS-start))s): $cmd"
    log_event test.t0 ok "$repo" "" "$cmd"
  else
    echo "FAIL t0 $repo ($((SECONDS-start))s): $cmd" >&2; tail -n 40 "$out" >&2
    log_event test.t0 fail "$repo" "" "$cmd"
  fi
  rm -f "$out"; return $rc
}

# ---------- guard (PreToolUse hook) ----------
# Reads the hook JSON on stdin. Exit 2 (with a reason on stderr) blocks the call.
# Only acts inside a batch worktree; humans pushing from normal checkouts are untouched.
cmd_guard() {
  local input cwd command
  input="$(cat)"
  command="$(jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null)" || exit 0
  [[ -n "$command" ]] || exit 0
  cwd="$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)"
  [[ -n "$cwd" && -d "$cwd" ]] && cd "$cwd"
  load_ws || exit 0
  case "$PWD/" in "$BATCH_DIR"/*) ;; *) exit 0 ;; esac
  if grep -Eq '\bgit\b([[:space:]]+(-C|-c)[[:space:]]+[^[:space:]]+|[[:space:]]+--[^[:space:]]+)*[[:space:]]+push\b|\bgh[[:space:]]+pr[[:space:]]+(create|merge)\b' <<<"$command"; then
    log_event guard blocked "" "" "$command"
    echo "Blocked: agents in a batch worktree must not push or open/merge PRs. Commit locally; the human integrates with 'ms-workspace ship'." >&2
    exit 2
  fi
  exit 0
}

# ---------- status ----------
cmd_status() {
  need_ws
  local fetch=0; [[ "${1:-}" == "--fetch" ]] && fetch=1
  local r dir base br ahead behind dirty batches
  while read -r r; do
    dir="$WS_ROOT/$r"
    if [[ ! -d "$dir/.git" ]]; then echo "$r: (not cloned)"; continue; fi
    base="$(repo_base "$r")"
    [[ $fetch -eq 1 ]] && git -C "$dir" fetch origin "$base" --quiet 2>/dev/null || true
    br="$(git -C "$dir" branch --show-current)"
    read -r behind ahead < <(git -C "$dir" rev-list --left-right --count "origin/$base...HEAD" 2>/dev/null || echo "? ?")
    dirty="$(git -C "$dir" status --porcelain | grep -c . || true)"
    batches="$(ls -d "$BATCH_DIR"/*/"$r" 2>/dev/null | awk -F/ '{print $(NF-1)}' | paste -sd, -)"
    echo "$r: $br | vs $base: +$ahead/-$behind | dirty $dirty${batches:+ | batches: $batches}"
  done < <(repo_names)
}

# ---------- context ----------
cmd_context() {
  load_ws || exit 0
  local b name n open
  echo "Workspace '$(cfg '.name // "unnamed"')' at $WS_ROOT ($(repo_names | wc -l) repos). Tool: ms-workspace (log, status, affected, test t0)."
  if [[ -d "$BATCH_DIR" ]] && ls -d "$BATCH_DIR"/*/ >/dev/null 2>&1; then
    echo "Active batches:"
    for b in "$BATCH_DIR"/*/; do
      name="$(basename "$b")"
      open="$(grep -c '^- \[ \]' "$b/TASKS.md" 2>/dev/null || true)"
      echo "  - $name: repos $(ls "$b" | grep -v TASKS.md | paste -sd, -), open tasks: ${open:-0}"
    done
  else
    echo "Active batches: none"
  fi
  echo "Recent actions:"
  cmd_log -n 5 | sed 's/^/  /'
}

# ---------- doctor ----------
cmd_doctor() {
  load_ws || echo "(no workspace.toml here: checking general tools only)"
  local bad=0
  ok()   { printf '  ok       %s\n' "$*"; }
  miss() { printf '  MISSING  %s\n' "$*"; bad=1; }
  warn() { printf '  warn     %s\n' "$*"; }
  have() { command -v "$1" >/dev/null 2>&1; }
  want() { if have "$1"; then ok "$1"; else miss "$1${2:+ ($2)}"; fi; }

  echo "Tools:"
  for t in git jq python3 gh; do want "$t"; done
  python3 -c 'import sys; sys.exit(0 if sys.version_info>=(3,11) else 1)' 2>/dev/null \
    && ok "python >= 3.11" || miss "python >= 3.11 (tomllib)"
  have claude && ok claude || warn "claude not in PATH"
  have tmux && ok tmux || warn "tmux (needed by ms-tmux-session)"
  have rtk && ok rtk || warn "rtk (optional: token-optimized shell output)"

  if [[ -n "${CFG_JSON:-}" ]]; then
    local stacks; stacks="$(cfg '[.repos[].stacks[]?] | unique | join(" ")')"
    echo "Stack tools (from workspace.toml: ${stacks:-none}):"
    [[ " $stacks " == *" maven "* ]]  && { want mvn; want java; have java && ok "$(java -version 2>&1 | head -1)"; }
    [[ " $stacks " == *" gradle "* ]] && want java
    [[ " $stacks " == *" pnpm "* ]]   && { want node; want pnpm; }
    [[ " $stacks " == *" npm "* ]]    && want node
    [[ " $stacks " == *" go "* ]]     && want go
    [[ " $stacks " == *" rust "* ]]   && want cargo
    [[ -n "$(cfg '.e2e.command // empty')" || -n "$(find "$WS_ROOT" -maxdepth 2 -name 'docker-compose*.yml' 2>/dev/null | head -1)" ]] && want docker

    echo "Workspace:"
    local r base d
    while read -r r; do
      if [[ ! -d "$WS_ROOT/$r/.git" ]]; then miss "repo '$r' not cloned at $WS_ROOT/$r"; continue; fi
      base="$(repo_base "$r")"
      git -C "$WS_ROOT/$r" rev-parse --verify --quiet "origin/$base" >/dev/null \
        || git -C "$WS_ROOT/$r" rev-parse --verify --quiet "$base" >/dev/null \
        || miss "repo '$r': base branch '$base' not found"
      for d in $(cfg --arg r "$r" '.repos[$r].deps[]?'); do
        cfg --arg d "$d" '.repos | has($d)' | grep -q true || miss "repo '$r' depends on unknown repo '$d'"
      done
    done < <(repo_names)
    [[ $bad -eq 0 ]] && ok "all repos present, bases and deps valid"
  fi

  echo "Resources:"
  local ram disk
  ram="$(free -g 2>/dev/null | awk '/^Mem:/{print $7}')"; disk="$(df -BG --output=avail "${WS_ROOT:-$HOME}" 2>/dev/null | tail -1 | tr -d ' G')"
  [[ -n "$ram" ]] && { [[ "$ram" -ge 4 ]] && ok "${ram}G RAM available" || warn "only ${ram}G RAM available"; }
  [[ -n "$disk" ]] && { [[ "$disk" -ge 10 ]] && ok "${disk}G disk free" || warn "only ${disk}G disk free"; }
  [[ -n "${STATE_DIR:-}" ]] && log_event doctor "$([[ $bad -eq 0 ]] && echo ok || echo fail)" "" "" ""
  return $bad
}

case "${1:-}" in
  guard)     shift; cmd_guard ;;
  status)    shift; cmd_status "$@" ;;
  context)   shift; cmd_context ;;
  doctor)    shift; cmd_doctor ;;
  batch)     shift; cmd_batch "$@" ;;
  affected)  shift; cmd_affected "$@" ;;
  test)      shift; cmd_test "$@" ;;
  log)       shift; cmd_log "$@" ;;
  integrate|ship|clean) die "'$1' is not implemented yet" ;;
  ""|-h|--help) sed -n '2,/^set -/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1" ;;
esac
